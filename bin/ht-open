#!/usr/bin/env python3
"""Show images and spreadsheets in the Hacker Terminal viewer.

Usage: ht-open ARQUIVO [ARQUIVO ...]
"""

import json
import os
import socket
import sys

USAGE = """uso: ht-open ARQUIVO [ARQUIVO ...]

Abre imagens (PNG, JPG, GIF, WebP, SVG...) e planilhas (CSV, TSV, XLSX, ODS)
numa aba de visualização do Hacker Terminal."""


def send(socket_path: str, request: dict) -> dict:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(socket_path)
        client.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while b"\n" not in data:
            chunk = client.recv(4096)
            if not chunk:
                break
            data += chunk
    return json.loads(data.decode() or "{}")


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0 if argv else 2
    socket_path = os.environ.get("HACKER_TERMINAL_SOCKET")
    if not socket_path:
        print("ht-open: use este comando dentro do Hacker Terminal.", file=sys.stderr)
        return 2
    status = 0
    for name in argv:
        path = os.path.abspath(os.path.expanduser(name))
        if not os.path.isfile(path):
            print(f"ht-open: arquivo não encontrado: {name}", file=sys.stderr)
            status = 1
            continue
        try:
            reply = send(socket_path, {"action": "open", "path": path, "pane": os.environ.get("HACKER_TERMINAL_PANE")})
        except (OSError, ValueError) as error:
            print(f"ht-open: o terminal não respondeu ({error}).", file=sys.stderr)
            return 1
        if not reply.get("ok"):
            print(f"ht-open: {reply.get('error', 'erro desconhecido')}", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
